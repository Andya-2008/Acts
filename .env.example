# If sign-in fails with auth/api-key-not-valid, open Google Cloud Console → APIs & Services →
# Credentials → your browser key → Application restrictions must allow this app (iOS bundle id /
# Android package + SHA-1), or use "None" while testing. "HTTP referrers" alone blocks native.
#
# EAS: use visibility Plain text or Sensitive for EXPO_PUBLIC_* (Secret vars are not available when
# resolving app.config.js on the build worker, so firebase keys may not bake into expo.extra).
# Match dashboard "Environments" to your build: preview profile → Preview; store production → Production.
# Must start with AIzaSy (capital i I, not lowercase L l — Expo UI can look like "AlzaSy" if mis-typed).
EXPO_PUBLIC_FIREBASE_API_KEY=
# Optional: keys from Firebase iOS / Android app snippets (override on device; web uses API_KEY only)
EXPO_PUBLIC_FIREBASE_API_KEY_IOS=
EXPO_PUBLIC_FIREBASE_API_KEY_ANDROID=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Legal / App Store (hosted at acts.app by default — see docs/legal-hosting.md)
# Use acts-d7c7f.web.app until acts.app is on Firebase Hosting; then https://acts.app
EXPO_PUBLIC_LEGAL_BASE_URL=https://acts-d7c7f.web.app
# Invite landing page (friend rewards use ?invitedBy= on this URL)
# EXPO_PUBLIC_INVITE_URL=https://acts-d7c7f.web.app/join
# Or after custom domain: https://acts.app/join
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://acts.app/privacy
# EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://acts.app/terms
# EXPO_PUBLIC_SUPPORT_URL=https://acts.app/support

# Google Sign-In (see docs/google-sign-in.md). Set EXPO_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false to hide UI.
# Web client ID = Firebase Console → Authentication → Google → Web client ID (required).
# iOS/Android = separate OAuth clients in Google Cloud (bundle id / package + SHA-1).
EXPO_PUBLIC_GOOGLE_SIGN_IN_ENABLED=true
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# --- Error Tracking (Sentry) ---
# Get free account at https://sentry.io → Create React Native project
# Copy your DSN from project settings (optional; leave empty to disable)
# EXPO_PUBLIC_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id

# --- Analytics & Monitoring ---
# Firebase Analytics is enabled by default (no config needed)
# Set up dashboards at https://console.firebase.google.com → Analytics

# --- Seed task catalog (scripts/seed-task-catalog.mjs; local only) ---
# Download service account JSON from Firebase Console → Project settings → Service accounts.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\acts-firebase-admin.json
# FIREBASE_PROJECT_ID=   # optional if EXPO_PUBLIC_FIREBASE_PROJECT_ID is set above

# --- AdMob (optional rewarded ads; OFF for 1.0.7 — requires a new native build to toggle) ---
# Leave false/unset for App Store builds without ads or App Tracking prompts.
# EXPO_PUBLIC_REWARDED_ADS_ENABLED=false
#
# iOS IDs (already wired as defaults in app.config.js when enabled):
# App ID:     ca-app-pub-2894172165945340~8547768533
# Rewarded:   ca-app-pub-2894172165945340/7726171684
# Override via EAS if needed:
# EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-2894172165945340~8547768533
# EXPO_PUBLIC_ADMOB_REWARDED_IOS=ca-app-pub-2894172165945340/7726171684

# --- EAS Build (Expo servers do not read this file unless you wire it) ---
# After `npm run eas:init`, Expo writes `extra.eas.projectId` into app.json (or set EAS_PROJECT_ID for CI).
# Add every EXPO_PUBLIC_* variable above in Expo → your project → Environment variables
# for the `preview` and `production` environments, or use `eas env:create`.
