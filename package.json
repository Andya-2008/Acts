{
  "name": "acts",
  "main": "expo-router/entry",
  "version": "1.0.7",
  "scripts": {
    "start": "expo start",
    "start:expo-go": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:init": "npx eas-cli init",
    "eas:whoami": "npx eas-cli whoami",
    "eas:build:status": "npx eas-cli build:list --platform ios --limit 1 --json --non-interactive",
    "eas:build:development": "npx eas-cli build --profile development",
    "eas:build:preview": "npx eas-cli build --profile preview",
    "eas:build:production": "npx eas-cli build --profile production --platform ios",
    "eas:build:production:android": "npx eas-cli build --profile production --platform android",
    "postinstall": "patch-package",
    "eas:submit": "npx eas-cli submit --profile production",
    "eas:submit:ios:latest": "npx eas-cli submit --profile production --platform ios --latest --non-interactive",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules",
    "firebase:deploy:storage": "firebase deploy --only storage",
    "firebase:deploy:rules-storage": "firebase deploy --only firestore:rules,storage",
    "firebase:deploy:functions": "firebase deploy --only functions",
    "firebase:deploy:backend": "firebase deploy --only functions,firestore:rules,storage",
    "firebase:deploy:hosting": "firebase deploy --only hosting",
    "firebase:deploy:indexes": "firebase deploy --only firestore:indexes",
    "preflight:store": "node scripts/store-preflight.mjs",
    "eas:env:hints": "node scripts/eas-env-hints.mjs",
    "seed:tasks:dry": "node scripts/seed-task-catalog.mjs --dry-run",
    "seed:tasks": "node scripts/seed-task-catalog.mjs",
    "catalog:picture-patch": "node scripts/patch-picture-catalog.mjs",
    "catalog:prune": "node scripts/prune-task-catalog.mjs",
    "catalog:niche-social": "node scripts/add-niche-social-tasks.mjs",
    "catalog:list-batches": "node scripts/list-catalog-review-batches.mjs",
    "catalog:list-batch2": "node scripts/list-catalog-review-batches.mjs 2",
    "catalog:list-batch3": "node scripts/list-catalog-review-batches.mjs 3",
    "catalog:list-batch4": "node scripts/list-catalog-review-batches.mjs 4",
    "catalog:deactivate": "node scripts/deactivate-task-ids.mjs",
    "stats:refresh-public": "node scripts/refresh-public-site-stats.mjs"
  },
  "dependencies": {
    "@bittingz/expo-widgets": "^3.0.2",
