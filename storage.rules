rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile avatars: `profile_pictures/{uid}.png` (see storageUploads.uploadUserProfilePhoto)
    match /profile_pictures/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.png'
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && fileName == request.auth.uid + '.png';
    }

    // Task memory photos: `task_photos/{uid}/{firestoreTaskDocId}.jpg` (see storageUploads.uploadTaskPhoto)
    // fileName is the last path segment only (e.g. `abcDocId123.jpg`).
    match /task_photos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && userId == request.auth.uid
        && fileName.size() > 4
        && fileName.size() < 512
        && fileName.matches('^[^/]+\\.jpg$')
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && userId == request.auth.uid;
    }

    // Seasonal challenge photos: `season_challenge_photos/{uid}/{seasonId}_{challengeId}_{ts}.jpg`
    match /season_challenge_photos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && userId == request.auth.uid
        && fileName.size() > 4
        && fileName.size() < 512
        && fileName.matches('^[^/]+\\.jpg$')
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && userId == request.auth.uid;
    }

    // Deed Feed post images: `deed_feed_photos/{uid}/{postDocId}.jpg`
    match /deed_feed_photos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && userId == request.auth.uid
        && fileName.size() > 4
        && fileName.size() < 512
        && fileName.matches('^[^/]+\\.jpg$')
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && userId == request.auth.uid;
    }
  }
}
