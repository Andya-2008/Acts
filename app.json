{
  "expo": {
    "name": "Acts",
    "slug": "acts",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "acts",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FA5A88"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.FrogCOO.Acts",
      "infoPlist": {
        "CFBundleDisplayName": "Acts",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FA5A88"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Acts uses your photo library for profile and task pictures.",
          "cameraPermission": "Acts uses your camera for profile and task pictures."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Acts reads contact names to suggest friend usernames. Phone matching can be added later."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FA5A88",
          "defaultChannel": "acts-retention"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "c90a1cdf-711c-4542-b42f-c05bd2a82420"
      },
      "router": {}
    },
    "owner": "andrewhyun114"
  }
}
