{
  "expo": {
    "name": "Acts",
    "slug": "acts",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "acts",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FA5A88"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.FrogCOO.Acts",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleDisplayName": "Acts",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.FrogCOO.Acts",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FA5A88"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Acts uses your photo library for profile and task pictures.",
          "cameraPermission": "Acts uses your camera for profile and task pictures."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Acts uses your contacts to suggest friends to connect with."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FA5A88",
          "defaultChannel": "acts-retention"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "frogcoo"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              { "name": "GoogleUtilities", "modular_headers": true },
              { "name": "FirebaseCoreInternal", "modular_headers": true }
            ]
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "c90a1cdf-711c-4542-b42f-c05bd2a82420"
      },
      "router": {}
    },
    "owner": "andrewhyun114"
  }
}